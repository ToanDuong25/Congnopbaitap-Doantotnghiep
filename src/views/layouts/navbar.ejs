<nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-2 mb-4">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-mortarboard-fill fs-3"></i>
      <span class="fw-bold">EduSubmit Portal</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-display="toggle" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link text-white" href="/dashboard">
              <i class="bi bi-speedometer2 me-1"></i> Bảng điều khiển
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white" href="/assignments">
              <i class="bi bi-journal-text me-1"></i> Tất cả bài tập & đồ án
            </a>
          </li>
          <% if (currentUser.role === 'teacher' || currentUser.role === 'admin') { %>
            <li class="nav-item">
              <a class="nav-link text-white" href="/assignments/create">
                <i class="bi bi-plus-circle me-1"></i> Tạo bài mới
              </a>
            </li>
          <% } else if (currentUser.role === 'student') { %>
            <li class="nav-item">
              <a class="nav-link text-white" href="/submissions/my">
                <i class="bi bi-clipboard-check me-1"></i> Bài đã nộp của tôi
              </a>
            </li>
          <% } %>
        </ul>

        <div class="d-flex align-items-center gap-3">
          <div class="text-white text-end d-none d-md-block">
            <div class="fw-bold"><%= currentUser.full_name %></div>
            <div class="small opacity-75">
              <span class="badge <%= currentUser.role === 'teacher' ? 'bg-warning text-dark' : 'bg-info text-dark' %>">
                <%= currentUser.role === 'teacher' ? '👨‍🏫 Giảng viên' : '👩‍🎓 Sinh viên' %>
              </span>
              <span>- <%= currentUser.user_code %></span>
            </div>
          </div>
          <a href="/auth/logout" class="btn btn-outline-light btn-sm px-3">
            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
          </a>
        </div>
      <% } else { %>
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link text-white" href="/auth/login">
              <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
            </a>
          </li>
          <li class="nav-item">
            <a class="btn btn-light btn-sm text-primary fw-bold ms-lg-2" href="/auth/register">
