<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<main class="container my-4">
  <%- include('../layouts/alerts') %>

  <!-- Header & Toolbar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h2 class="fw-bold mb-1">Danh Sách Bài Tập & Đồ Án</h2>
      <p class="text-muted mb-0">Xem và nộp các bài tập môn học cũng như đề tài đồ án tốt nghiệp</p>
    </div>
    <% if (user.role === 'teacher' || user.role === 'admin') { %>
      <div class="d-flex gap-2">
        <a href="/assignments/create" class="btn btn-primary">
          <i class="bi bi-plus-lg me-1"></i> Tạo Bài Tập Mới
        </a>
      </div>
    <% } %>
  </div>

  <!-- Bộ lọc (Filters) -->
  <div class="card shadow-sm mb-4">
    <div class="card-body py-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex flex-wrap gap-2">
          <a href="/assignments?type=all" class="btn btn-sm <%= typeFilter === 'all' ? 'btn-primary' : 'btn-outline-secondary' %>">
            Tất cả
          </a>
          <a href="/assignments?type=assignment" class="btn btn-sm <%= typeFilter === 'assignment' ? 'btn-primary' : 'btn-outline-secondary' %>">
            <i class="bi bi-journal-text me-1"></i> Bài tập môn học
          </a>
          <a href="/assignments?type=graduation_thesis" class="btn btn-sm <%= typeFilter === 'graduation_thesis' ? 'btn-primary' : 'btn-outline-secondary' %>">
            <i class="bi bi-mortarboard-fill me-1"></i> Đồ án tốt nghiệp
          </a>
        </div>
        <% if (user.role === 'teacher') { %>
          <div>
            <a href="/assignments?mine=true" class="btn btn-sm btn-outline-info text-dark">
              <i class="bi bi-person-check me-1"></i> Bài của tôi tạo
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Danh sách bài tập -->
  <div class="row g-4">
    <% if (assignments.length === 0) { %>
      <div class="col-12">
        <div class="card shadow-sm p-5 text-center">
          <i class="bi bi-folder-x display-3 text-secondary mb-3"></i>
          <h4>Không tìm thấy bài tập hoặc đồ án nào</h4>
          <p class="text-muted">Chưa có nội dung nào phù hợp với bộ lọc hiện tại.</p>
          <% if (user.role === 'teacher') { %>
            <div class="mt-2">
              <a href="/assignments/create" class="btn btn-primary">Tạo bài tập đầu tiên</a>
            </div>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <% assignments.forEach(item => { %>
        <% const isExpired = new Date(item.due_date) < new Date(); %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm d-flex flex-column border-top border-4 <%= item.type === 'graduation_thesis' ? 'border-warning' : 'border-primary' %>">
            <div class="card-body flex-grow-1">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <% if (item.type === 'graduation_thesis') { %>
                  <span class="badge badge-thesis">
                    <i class="bi bi-mortarboard-fill me-1"></i> Đồ án tốt nghiệp
                  </span>
                <% } else { %>
                  <span class="badge badge-assignment">
                    <i class="bi bi-journal-code me-1"></i> Bài tập môn học
                  </span>
                <% } %>

                <% if (isExpired) { %>
                  <span class="badge bg-secondary">Đã hết hạn</span>
                <% } else { %>
                  <span class="badge bg-success">Đang mở</span>
                <% } %>
              </div>

              <h5 class="card-title fw-bold mt-2 mb-2">
                <a href="/assignments/<%= item.id %>" class="text-decoration-none text-dark">
                  <%= item.title %>
                </a>
              </h5>

              <p class="card-text text-muted small text-truncate-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                <%= item.description || 'Không có mô tả chi tiết.' %>
              </p>

              <div class="small text-muted mb-2">
                <div><i class="bi bi-person-circle me-1"></i> GV: <%= item.teacher_name %></div>
                <div><i class="bi bi-alarm me-1"></i> Hạn chót: <strong><%= moment(item.due_date).format('DD/MM/YYYY HH:mm') %></strong></div>
              </div>

              <!-- Trạng thái của sinh viên nếu là tài khoản sinh viên -->
              <% if (user.role === 'student') { %>
                <div class="mt-3 pt-2 border-top">
                  <% if (item.my_submission_id) { %>
                    <div class="d-flex justify-content-between align-items-center">
                      <span class="badge bg-primary">
                        <i class="bi bi-check2 me-1"></i> Đã nộp bài
                      </span>
                      <% if (item.my_status === 'graded') { %>
                        <span class="badge bg-success fs-6"><%= item.my_score %> đ</span>
                      <% } else { %>
                        <span class="badge bg-light text-secondary border">Chờ chấm điểm</span>
                      <% } %>
                    </div>
                  <% } else { %>
                    <span class="badge bg-danger">
                      <i class="bi bi-exclamation-circle me-1"></i> Chưa nộp
                    </span>
                  <% } %>
                </div>
              <% } else if (user.role === 'teacher') { %>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-people-fill me-1"></i> <%= item.total_submissions %> bài nộp
                  </span>
                </div>
              <% } %>
            </div>

            <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
              <div class="d-grid">
                <a href="/assignments/<%= item.id %>" class="btn btn-outline-primary btn-sm">
                  Chi tiết <%= item.type === 'graduation_thesis' ? 'đồ án' : 'bài tập' %> &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</main>

<%- include('../layouts/footer') %>
