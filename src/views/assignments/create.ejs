<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<main class="container my-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/assignments" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
          <h4 class="fw-bold mb-0 text-primary">
            <i class="bi bi-plus-circle-fill me-2"></i>Tạo Bài Tập / Đề Tài Đồ Án Mới
          </h4>
        </div>
        <div class="card-body p-4">
          <%- include('../layouts/alerts') %>

          <form action="/assignments" method="POST" enctype="multipart/form-data">
            <!-- Loại đề tài / bài tập -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Loại hình: <span class="text-danger">*</span></label>
              <div class="d-flex gap-4">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="type" id="type_assignment" value="assignment" <%= defaultType === 'assignment' ? 'checked' : '' %>>
                  <label class="form-check-label fw-semibold" for="type_assignment">
                    <i class="bi bi-journal-code text-primary me-1"></i> Bài tập môn học
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="type" id="type_thesis" value="graduation_thesis" <%= defaultType === 'graduation_thesis' ? 'checked' : '' %>>
                  <label class="form-check-label fw-semibold text-warning-emphasis" for="type_thesis">
                    <i class="bi bi-mortarboard-fill text-warning me-1"></i> Đồ án tốt nghiệp
                  </label>
                </div>
              </div>
            </div>

            <!-- Tiêu đề -->
            <div class="mb-3">
              <label for="title" class="form-label fw-semibold">Tiêu đề bài tập / Tên đề tài đồ án <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="title" name="title" placeholder="VD: Đồ án tốt nghiệp: Xây dựng hệ thống học trực tuyến" required>
            </div>

            <!-- Thời hạn nộp & Thang điểm -->
            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="due_date" class="form-label fw-semibold">Hạn chót nộp bài (Deadline) <span class="text-danger">*</span></label>
                <input type="datetime-local" class="form-control" id="due_date" name="due_date" required>
              </div>
              <div class="col-md-6 mb-3">
                <label for="max_score" class="form-label fw-semibold">Thang điểm tối đa</label>
                <input type="number" class="form-control" id="max_score" name="max_score" value="10.0" step="0.5" min="1" max="100">
              </div>
            </div>

            <!-- Mô tả chi tiết -->
            <div class="mb-3">
              <label for="description" class="form-label fw-semibold">Mô tả yêu cầu chi tiết</label>
              <textarea class="form-control" id="description" name="description" rows="6" placeholder="Nhập các yêu cầu cụ thể, mục tiêu cần đạt, hướng dẫn nộp bài, tiêu chí chấm điểm..."></textarea>
            </div>

            <!-- Đính kèm tài liệu đề bài -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Tài liệu đề bài đính kèm (File PDF, DOCX, ZIP... nếu có)</label>
              <div class="dropzone-box" onclick="document.getElementById('attachment').click();">
                <i class="bi bi-cloud-arrow-up display-4 text-primary d-block mb-2"></i>
                <div class="fw-semibold">Nhấn vào đây để chọn file tài liệu đề bài</div>
                <div class="text-muted small">Hỗ trợ .pdf, .docx, .zip, .rar... Tối đa 50MB</div>
                <input type="file" id="attachment" name="attachment" class="d-none">
                <div id="attachment_name" class="mt-2 text-success fw-semibold d-none"></div>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="/assignments" class="btn btn-light px-4">Hủy bỏ</a>
              <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-check-circle me-1"></i> Xuất Bản Bài Tập / Đồ Án
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
